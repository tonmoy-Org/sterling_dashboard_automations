# FieldEdge Dashboard Credentials for Dispatch Automation
DASH_EMAIL=your_email@example.com
DASH_PASSWORD=your_password_here

# Scraper Rules Configuration
RULES_FILE_PATH=config/scraper_rules.json

# Backend API Configuration
BACKEND_API_URL=http://[IP_ADDRESS]/api/

# Dashboard API Login (JWT) - used for protected endpoints like /automation/dispatch-config/
BACKEND_API_EMAIL=your_dashboard_email@example.com
BACKEND_API_PASSWORD=your_dashboard_password
# Optional: login endpoint (default /auth/login)
# BACKEND_LOGIN_PATH=/auth/login
# Optional: provide a JWT directly instead of logging in
# BACKEND_API_TOKEN=

# Browser Configuration
HEADLESS=true
PORT=3000
